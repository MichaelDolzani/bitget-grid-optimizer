# Bitget API credentials
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_PASSPHRASE=your_passphrase_here

# Bot configuration
BOT_ID=your_bot_id_here
SYMBOL=BTCUSDT

# Stato corrente del bot (leggilo dal pannello Bitget e aggiornalo qui).
# Usato come fallback se l'API bot-detail non risponde.
BOT_LOWER_PRICE=
BOT_UPPER_PRICE=
BOT_GRID_NUM=
BOT_INVEST_AMOUNT=

# Optimizer settings (opzionali — valori di default se omessi)
CHECK_INTERVAL_MINUTES=30
SHIFT_THRESHOLD_PCT=5.0
ATR_MULTIPLIER=2.5
SIGMA_MULTIPLIER=1.5
STEP_TARGET_PCT=0.8
MAX_GRID_COUNT=150
COOLDOWN_MINUTES=60
TTM_SQUEEZE_ENABLED=true
VOLATILITY_SPIKE_MULTIPLIER=1.5
VOLATILITY_SPIKE_RANGE_EXPAND=1.20
GRID_TYPE=geometric

# Fund manager
MIN_ADD_FUNDS_USDT=10.0
FUND_CHECK_INTERVAL_HOURS=6
RESERVE_PCT=2.0

# Web / Auth (FASE 3+)
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ADMIN_EMAIL=your@email.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/callback
FERNET_KEY=

# Database (FASE 3+)
DATABASE_URL=sqlite:///./bitget.db

# Google Chat webhook (FASE 5+)
GCHAT_WEBHOOK_URL=
